import Image from "next/image";
import { notFound } from "next/navigation";

interface Project {
  id: number;
  title: string;
  description: string;
  project_url: string;
  cover_image: string;
}

interface Profile {
  id: number;
  slug: string;
  full_name: string;
  headline: string;
  bio: string;
  email: string;
  phone: string;
  avatar_url: string;
  social_links: Record<string, string>;
  projects: Project[];
}

export default async function PortfolioViewer({
  params,
}: {
  params: Promise<{ slug: string }>;
}) {
  const { slug } = await params;
  
  // ✅ Ensure strict fallback to explicit backend URL
  const backendBase = process.env.NEXT_PUBLIC_API_BASE || "http://127.0.0.1:8000";

  let profile: Profile;

  try {
    const apiRes = await fetch(`${backendBase}/api/v1/portfolios/${slug}/`, {
      cache: "no-store",
      headers: { Accept: "application/json" },
    });

    if (!apiRes.ok) {
      notFound();
    }

    profile = await apiRes.json();
  } catch (error) {
    notFound();
  }

  // ✅ Construct absolute Avatar URL for relative paths (/media/...)
  const getAvatarUrl = (url: string) => {
    if (!url) return null;
    if (url.startsWith("http://") || url.startsWith("https://") || url.startsWith("data:")) {
      return url;
    }
    return `${backendBase}${url.startsWith("/") ? "" : "/"}${url}`;
  };

  const finalAvatarUrl = getAvatarUrl(profile.avatar_url);
  const vCardUrl = `${backendBase}/api/v1/portfolios/${profile.slug}/vcard/`;

  return (
    <main className="min-h-screen bg-zinc-950 text-zinc-100 flex items-center justify-center p-4">
      <div className="w-full max-w-md bg-zinc-900 border border-zinc-800 rounded-3xl p-6 shadow-2xl space-y-6">
        
        {/* Avatar Section */}
        <header className="text-center space-y-3">
          <div className="w-24 h-24 mx-auto rounded-full overflow-hidden border-2 border-indigo-500 bg-zinc-800 flex items-center justify-center relative">
            {finalAvatarUrl ? (
              finalAvatarUrl.startsWith("data:") ? (
                <img
                  src={finalAvatarUrl}
                  alt={profile.full_name}
                  className="w-full h-full object-cover"
                />
              ) : (
                <Image
                  src={finalAvatarUrl}
                  alt={profile.full_name}
                  width={96}
                  height={96}
                  className="w-full h-full object-cover"
                />
              )
            ) : (
              <span className="text-3xl font-bold text-zinc-400">
                {profile.full_name?.charAt(0) || "U"}
              </span>
            )}
          </div>

          <h1 className="text-2xl font-bold text-white">{profile.full_name}</h1>
          <p className="text-indigo-400 text-sm font-medium">{profile.headline}</p>
        </header>

        {/* Bio */}
        {profile.bio && (
          <p className="text-zinc-400 text-sm leading-relaxed text-center">
            "{profile.bio}"
          </p>
        )}

        {/* ✅ FIX: Direct <a> Tag with backendBase - no window.open relative call */}
        <div>
          <a
            href={vCardUrl}
            target="_blank"
            rel="noopener noreferrer"
            className="block w-full bg-indigo-600 hover:bg-indigo-500 text-white text-center py-3 rounded-xl text-sm font-medium transition-colors shadow-lg"
          >
            Save Contact
          </a>
          <p className="text-zinc-500 text-xs text-center mt-2">
            Opens native address book to save vCard
          </p>
        </div>

        {/* Contact Links */}
        <div className="space-y-2 pt-2 border-t border-zinc-800/60 text-sm">
          {profile.email && (
            <a href={`mailto:${profile.email}`} className="block text-indigo-400 hover:underline">
              ✉ {profile.email}
            </a>
          )}
          {profile.phone && (
            <a href={`tel:${profile.phone}`} className="block text-indigo-400 hover:underline">
              📞 {profile.phone}
            </a>
          )}
        </div>

        {/* Social Links */}
        {profile.social_links && (
          <div className="flex flex-wrap gap-2 pt-2">
            {Object.entries(profile.social_links).map(([platform, url]) => (
              <a
                key={platform}
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                className="px-3 py-1 bg-zinc-800 hover:bg-zinc-700 text-xs text-indigo-400 rounded-full capitalize transition border border-zinc-700/50"
              >
                {platform}
              </a>
            ))}
          </div>
        )}

      </div>
    </main>
  );
}